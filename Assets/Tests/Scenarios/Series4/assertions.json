{
  "scenarioName": "Series 4 - Teacher Intervention",
  "description": "Verify teacher calm student -> resolve influence -> ngan chain tiep tuc. Them bien so teacher action vao.",
  "series": 4,
  "level": "FirstDaySummerBreak",
  "testTimeScale": 10,
  "maxGameTimeSeconds": 120,

  "teacherActions": [
    {
      "time": 42,
      "action": "CalmStudent",
      "targetStudent": "Bình",
      "description": "Teacher calm Bình ngay sau khi Bình knock object (40s)"
    }
  ],

  "assertions": [
    {
      "id": "binh_knocked_40s",
      "component": "StudentInteractionProcessor",
      "eventType": "KnockedOverObject",
      "source": "student_binh",
      "target": "student_lan",
      "minTime": 39.0,
      "maxTime": 41.0,
      "mustOccur": true,
      "afterEventId": "",
      "description": "Bình van trigger KnockedOverObject tai 40s"
    },
    {
      "id": "lan_influenced",
      "component": "StudentInfluenceManager",
      "eventType": "InfluenceApplied",
      "source": "Bình",
      "target": "Lan",
      "minTime": 39.0,
      "maxTime": 42.0,
      "mustOccur": true,
      "afterEventId": "binh_knocked_40s",
      "description": "Lan van nhan influence tu Bình"
    },
    {
      "id": "teacher_calm_binh",
      "component": "TeacherController",
      "eventType": "CalmStudent",
      "source": "",
      "target": "Bình",
      "minTime": 42,
      "maxTime": 43,
      "mustOccur": true,
      "afterEventId": "lan_influenced",
      "description": "Teacher calm Bình tai 42s"
    },
    {
      "id": "binh_influence_resolved",
      "component": "StudentInfluenceManager",
      "eventType": "InfluenceResolved",
      "source": "Bình",
      "target": "",
      "minTime": 42,
      "maxTime": 44,
      "mustOccur": true,
      "afterEventId": "teacher_calm_binh",
      "description": "Influence tu Bình duoc resolve sau khi teacher calm"
    },
    {
      "id": "no_lan_critical",
      "component": "StudentAgent",
      "eventType": "StateChanged",
      "source": "Lan",
      "target": "",
      "minTime": 42,
      "maxTime": 120,
      "mustOccur": false,
      "afterEventId": "binh_influence_resolved",
      "messageContains": "Critical",
      "description": "Lan KHONG nen len Critical sau khi Bình da bi calm (chain bi cat)"
    }
  ],

  "expectedEndState": "",
  "notes": "Series 4 verify teacher action ngat duoc influence chain. Sau khi calm Bình, Lan khong bi escalate them. no_lan_critical mustOccur=false nghia la event nay KHONG nen xay ra."
}
